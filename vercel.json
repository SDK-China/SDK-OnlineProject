{
    "version": 2,
    "builds": [
        {
            "src": "index.js",
            "use": "@vercel/node",
            "config": {
                "includeFiles": ["lib/**", "src/**/view/**"]
            }
        }
    ],
    "functions": {
        "index.js": {
            "maxDuration": 300
        }
    },
    "routes": [
        {
            "src": "/(.*)",
            "dest": "index.js"
        }
    ],
    "crons": [
        {
            "path": "/FactoryEntry/Report/auto-renew",
            "schedule": "0 22 * * *"
        }
    ]
}
